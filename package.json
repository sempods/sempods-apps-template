{
  "name": "my-sempods-apps",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "new-app": "node .sempods/scripts/new-app.mjs",
    "dev": "node .sempods/scripts/dev.mjs",
    "check": "node .sempods/scripts/check.mjs",
    "sdk-update": "node .sempods/scripts/sdk-update.mjs"
  },
  "devDependencies": {
    "@sempods/app-sdk": "0.3.0",
    "@sempods/client-sdk": "0.3.0",
    "markdown-extensions": "2.0.0",
    "remark": "15.0.1",
    "remark-validate-links": "13.1.0",
    "typescript": "7.0.2",
    "unified-engine": "11.2.2"
  },
  "overrides": {
    "unified-engine": {
      "glob": "13.0.6"
    }
  }
