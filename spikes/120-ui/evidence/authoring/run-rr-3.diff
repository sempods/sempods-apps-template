+/**
+ * Moves the Details screen to the next open task of the list. The unsaved
+ * edits are settled first (`leave`: the SDK asks, and a refusal keeps the
+ * screen). The address is replaced, so Close still returns to where the
+ * screen was opened from.
+ */
+function NextTask({ subject, leave }: { readonly subject: string; readonly leave: () => Promise<boolean> }) {
+  const navigate = useNavigate();
+  const list = useList(taskFields);
+  const { view: target } = useAppState();
+  const items = (list.data?.items ?? []).filter((item) => !item.data.done);
+  const index = items.findIndex((item) => item.iri === subject);
+  const next = index >= 0 ? items[index + 1] : undefined;
+  const goNext = async () => {
+    if (next && (await leave())) navigate(taskPath(next.iri, target?.contextIri), { replace: true });
+  };
+  return (
+    <kit.Button variant="secondary" disabled={!next} onPress={() => void goNext()}>Next task</kit.Button>
   );
 }
