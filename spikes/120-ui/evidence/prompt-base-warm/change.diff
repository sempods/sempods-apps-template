-/* 1. Palette roles. Theme "calm" (the default). */
+/* 1. Palette roles. Theme "calm" (the default), now warm: cream and brown neutrals with a terracotta accent. */
 :root {
   color-scheme: light dark;
-  --background: light-dark(#ffffff, #111315);
-  --foreground: light-dark(#1f2933, #e5e7eb);
-  --card: light-dark(#ffffff, #181b1f);
+  --background: light-dark(#fffaf4, #17120e);
+  --foreground: light-dark(#3a2a20, #f3e8dc);
