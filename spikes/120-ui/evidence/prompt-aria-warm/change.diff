@@ -115,3 +115,9 @@
   display: grid;
   gap: 6px;
 }
+/* Tailwind's preflight sets margin: 0 on every element, which takes the
+   browser's centring (margin: auto) from native modal dialogs such as the
+   SDK's confirmations. Unlayered, this restores it. */
+:where(dialog:modal) {
+  margin: auto;
+}
