{
  "name": "@sempods/apps",
  "version": "0.7.0-dev",
  "description": "Tooling for a sempods apps repository: create, check, update and publish several sempods apps with one shared SDK version.",
  "keywords": [
    "sempods",
    "pod",
    "apps",
    "pwa",
    "cli"
  ],
  "license": "MIT-0",
  "author": "Danilo Stein",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sempods/sempods-apps-template.git",
    "directory": "packages/apps"
  },
  "homepage": "https://github.com/sempods/sempods-apps-template/tree/main/packages/apps#readme",
  "bugs": {
    "url": "https://github.com/sempods/sempods-apps-template/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.28.2"
  },
  "bin": {
    "sempods-apps": "bin/sempods-apps.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "skeleton/",
    "instructions/",
    "skills/",
    "shared/",
    "update-policy.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node maintainer/snapshot.mjs"
  },
  "dependencies": {
    "semver": "7.8.5",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "markdown-extensions": "2.0.0",
    "remark": "15.0.1",
    "remark-validate-links": "13.1.0",
    "unified-engine": "11.2.2"
  },
  "peerDependencies": {
    "@sempods/app-sdk": "^0.5.0",
    "@sempods/client-sdk": "^0.5.0"
  }
}
